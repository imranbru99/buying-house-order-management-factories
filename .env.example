APP_NAME=TradeFlow
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Default: SQLite file for easy local demo (touch database/database.sqlite)
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
# MySQL (production / team shared dev):
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=tradeflow
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="support@tradeflow.test"
MAIL_FROM_NAME="${APP_NAME}"

# --- TradeFlow ---
TRADEFLOW_APP_NAME=TradeFlow
TRADEFLOW_SUPPORT_EMAIL=support@tradeflow.test
TRADEFLOW_DEMO_ENABLED=true
DEMO_SEED=true
TRADEFLOW_DEMO_TENANT=global-apparel
TRADEFLOW_DEMO_SHOW_CREDENTIALS=true
TRADEFLOW_BASE_DOMAIN=tradeflow.test
TRADEFLOW_SUBDOMAIN_TENANCY=true
TRADEFLOW_DEFAULT_CURRENCY=USD
TRADEFLOW_DEFAULT_LOCALE=en
TRADEFLOW_DEFAULT_TIMEZONE=UTC

# Optional: create platform superadmin during demo seed (password NOT documented in README)
DEMO_PLATFORM_ADMIN=false
DEMO_PLATFORM_ADMIN_EMAIL=superadmin@platform.tradeflow.test

# --- AI Hub (placeholders) ---
AI_HUB_PROVIDER=openai
AI_HUB_API_KEY=
AI_HUB_DEFAULT_MODEL=gpt-4o-mini
AI_CATALOG_ENABLED=false

VITE_APP_NAME="${APP_NAME}"
